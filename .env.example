NODE_ENV=development
PORT=5000
LOG_LEVEL=debug
# Comma-separated browser origins (scheme://host[:port], no path or trailing slash).
# '*' is allowed in development/test only; production refuses to start with '*' or an empty list.
# Native mobile apps send no Origin header and are not affected. Production example (placeholders):
# CORS_ORIGINS=https://app.your-domain.example,https://www.your-domain.example
CORS_ORIGINS=*
DATABASE_URL=Database URL for your PostgreSQL database (e.g., postgresql://username:password@host:port/database_name)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
TRUST_PROXY=false
JWT_ACCESS_SECRET=Random secret of at least 32 characters (e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=30
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=user@example.com
SMTP_PASS=your_smtp_password
SMTP_FROM=no-reply@example.com
BLOB_READ_WRITE_TOKEN=
# Owner seed only (npm run prisma:seed). NOT read by the app at startup; leave unset in production after seeding.
# Password rules: 8-72 chars with an uppercase letter, a lowercase letter and a number (the placeholder below is rejected on purpose).
SEED_OWNER_EMAIL=owner@example.com
SEED_OWNER_PASSWORD=CHANGE_ME_choose_a_strong_password
SEED_OWNER_FULL_NAME=First Owner
SEED_OWNER_PHONE=+12025550100
