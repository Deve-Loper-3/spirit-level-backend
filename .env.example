NODE_ENV=development
PORT=5000
LOG_LEVEL=debug
# Comma-separated browser origins (scheme://host[:port], no path or trailing slash).
# '*' is allowed in development/test only; production refuses to start with '*' or an empty list.
# Native mobile apps send no Origin header and are not affected. Production example (placeholders):
# CORS_ORIGINS=https://app.your-domain.example,https://www.your-domain.example
CORS_ORIGINS=*
DATABASE_URL=Database URL for your PostgreSQL database (e.g., postgresql://username:password@host:port/database_name)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
TRUST_PROXY=false
# REQUIRED: the app refuses to start until this placeholder is replaced with a random secret (32+ characters).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=CHANGE_ME_generate_a_random_secret_of_at_least_32_characters
# A positive whole number plus a unit: s, m, h or d (15m, 1h, 7d). Bare numbers such as 900 are rejected.
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=30
# Refresh sessions are only deleted this many days after they expired or were revoked (must be > 0;
# reuse detection needs revoked sessions to stay for a while).
REFRESH_SESSION_CLEANUP_GRACE_DAYS=7
# Limit for POST /auth/refresh and /auth/logout (shared counter, per IP). Stricter than the login limit.
# REFRESH_RATE_LIMIT_MAX defaults to 60 when unset (and is raised automatically when NODE_ENV=test,
# so keep it commented out in the .env used for tests).
REFRESH_RATE_LIMIT_WINDOW_MS=900000
# REFRESH_RATE_LIMIT_MAX=60
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=user@example.com
SMTP_PASS=your_smtp_password
SMTP_FROM=no-reply@example.com
BLOB_READ_WRITE_TOKEN=
# Owner seed only (npm run prisma:seed). NOT read by the app at startup; leave unset in production after seeding.
# Password rules: 8-72 chars with an uppercase letter, a lowercase letter and a number (the placeholder below is rejected on purpose).
SEED_OWNER_EMAIL=owner@example.com
SEED_OWNER_PASSWORD=CHANGE_ME_choose_a_strong_password
SEED_OWNER_FULL_NAME=First Owner
SEED_OWNER_PHONE=+12025550100
