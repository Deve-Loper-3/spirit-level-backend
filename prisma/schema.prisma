generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  MEMBER
  COACH
  ADMIN
  OWNER
}

enum AccountStatus {
  PENDING
  ACTIVE
  DISABLED
}

enum Gender {
  MALE
  FEMALE
  NON_BINARY
  PREFER_NOT_TO_SAY
}

enum Relationship {
  PARENT
  SPOUSE
  SIBLING
  CHILD
  FRIEND
  GUARDIAN
  OTHER
}

enum AuditAction {
  LOGIN_SUCCESS
  LOGIN_FAILED
  STAFF_CREATED
  STAFF_CREATE_DENIED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_OTP_VERIFIED
  PASSWORD_RESET_OTP_FAILED
  PASSWORD_RESET_COMPLETED
  LOGOUT
  COACH_UPDATED
  COACH_STATUS_CHANGED
  PLAN_CREATED
  PLAN_UPDATED
  PLAN_STATUS_CHANGED
  CAFE_ORDER_STATUS_CHANGED
  COACH_AVAILABILITY_UPDATED
  COACH_UNAVAILABILITY_CREATED
  COACH_UNAVAILABILITY_UPDATED
  COACH_UNAVAILABILITY_DELETED
  SESSION_COACH_REPLACED
  BOOKING_RULE_CREATED
  BOOKING_RULE_UPDATED
  BOOKING_RULE_DELETED
  APPOINTMENT_TYPE_CREATED
  APPOINTMENT_TYPE_UPDATED
  APPOINTMENT_CREATED
  APPOINTMENT_CANCELLED
}

enum AppointmentState {
  BOOKED
  CANCELLED
}

enum LoginFailureReason {
  INVALID_CREDENTIALS
  ACCOUNT_PENDING
  ACCOUNT_DISABLED
}

enum CoachType {
  SALARIED
  FREELANCE
}

enum CoachStatus {
  ACTIVE
  INACTIVE
}

model User {
  id                      String             @id
  fullName                String
  email                   String             @unique
  phone                   String
  whatsappNumber          String?
  gender                  Gender
  birthDay                Int?
  birthMonth              Int?
  profileImageUrl         String?
  passwordHash            String
  role                    Role               @default(MEMBER)
  status                  AccountStatus      @default(PENDING)
  mustChangePassword      Boolean            @default(false)
  waiverAcceptedAt        DateTime?
  registrationCompletedAt DateTime?
  lastLoginAt             DateTime?
  emergencyContact        EmergencyContact?
  coach                   Coach?
  refreshSessions         RefreshSession[]
  auditLogs               AuditLog[]
  passwordResetOtps       PasswordResetOtp[]
  cafeOrders              CafeOrder[]
  appointments            Appointment[]
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
}

model EmergencyContact {
  id           String        @id
  userId       String        @unique
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String?
  phone        String
  relationship Relationship?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Coach {
  id                String                  @id
  userId            String                  @unique
  user              User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  coachType         CoachType
  bio               String?
  status            CoachStatus             @default(ACTIVE)
  classes           ClassCoach[]
  slots             ClassSlotCoach[]
  sessions          ClassSessionCoach[]
  availabilityDays  CoachAvailabilityDay[]
  availabilitySlots CoachAvailabilitySlot[]
  unavailability    CoachUnavailability[]
  appointments      Appointment[]
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  @@index([status])
  @@index([coachType])
}

// Recurring weekly hours. One row per (coach, ISO weekday). `isAvailable = false` or a missing row means the
// coach is not assignable on that weekday. Times are facility wall-clock (FACILITY_TIMEZONE), HH:mm, no midnight crossing.
model CoachAvailabilityDay {
  coachId     String
  coach       Coach                   @relation(fields: [coachId], references: [id], onDelete: Cascade)
  dayOfWeek   Int
  isAvailable Boolean                 @default(true)
  slots       CoachAvailabilitySlot[]
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  @@id([coachId, dayOfWeek])
  @@map("coach_availability_days")
}

// CHECK constraints (dayOfWeek 1-7, endTime > startTime) and the composite FK live in the migration SQL.
// Overlap between slots of one day is rejected by the service inside the replace-week transaction.
model CoachAvailabilitySlot {
  id        String               @id
  coachId   String
  coach     Coach                @relation(fields: [coachId], references: [id], onDelete: Cascade)
  dayOfWeek Int
  day       CoachAvailabilityDay @relation(fields: [coachId, dayOfWeek], references: [coachId, dayOfWeek], onDelete: Cascade)
  startTime DateTime             @db.Time(0)
  endTime   DateTime             @db.Time(0)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@unique([coachId, dayOfWeek, startTime])
  @@map("coach_availability_slots")
}

// Date-specific unavailability (leave). Inclusive facility-local dates. Overlap per coach is rejected by the service.
// CHECKs (endDate >= startDate, reason not blank and <= 200, note <= 1000) live in the migration SQL.
model CoachUnavailability {
  id        String   @id
  coachId   String
  coach     Coach    @relation(fields: [coachId], references: [id], onDelete: Cascade)
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  reason    String
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([coachId, startDate, endDate])
  @@index([startDate, endDate])
  @@map("coach_unavailability")
}

// Bookable one-to-one appointment (PT) type. Name is unique among ACTIVE types (case-insensitive, trimmed) through a
// partial unique index in the migration SQL. CHECKs (name not blank, durationMin 1-480, buffers >= 0) are SQL only.
model AppointmentType {
  id              String        @id
  name            String
  durationMin     Int
  bufferBeforeMin Int           @default(0)
  bufferAfterMin  Int           @default(0)
  isActive        Boolean       @default(true)
  appointments    Appointment[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@map("appointment_types")
}

// startAt / endAt are UTC instants. The buffer columns are snapshots of the type at booking time.
// CHECK endAt > startAt and the partial index (coachId, startAt, endAt) WHERE state = 'BOOKED' live in the migration SQL.
// Overlap between BOOKED appointments of one coach is enforced by the service (coachSchedule.service), not the DB.
model Appointment {
  id                String           @id
  coachId           String
  coach             Coach            @relation(fields: [coachId], references: [id], onDelete: Restrict)
  memberId          String
  member            User             @relation(fields: [memberId], references: [id], onDelete: Restrict)
  appointmentTypeId String
  appointmentType   AppointmentType  @relation(fields: [appointmentTypeId], references: [id], onDelete: Restrict)
  startAt           DateTime         @db.Timestamptz(3)
  endAt             DateTime         @db.Timestamptz(3)
  bufferBeforeMin   Int
  bufferAfterMin    Int
  state             AppointmentState @default(BOOKED)
  cancelledAt       DateTime?        @db.Timestamptz(3)
  version           Int              @default(1)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([coachId, startAt])
  @@index([memberId, startAt])
  @@index([appointmentTypeId])
  @@map("appointments")
}

model RefreshSession {
  id        String    @id
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  ipAddress String?
  userAgent String?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model PasswordResetOtp {
  id             String    @id
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  otpHash        String
  expiresAt      DateTime
  attempts       Int       @default(0)
  verifiedAt     DateTime?
  usedAt         DateTime?
  invalidatedAt  DateTime?
  resetTokenHash String?   @unique
  ipAddress      String?
  createdAt      DateTime  @default(now())

  @@index([userId, createdAt])
}

model AuditLog {
  id        String      @id
  userId    String?
  user      User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    AuditAction
  reason    String?
  email     String?
  actorId   String?
  actorRole String?
  details   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime    @default(now())

  @@index([userId, createdAt])
}

enum PlanKind {
  SUBSCRIPTION
  CREDIT_PACK
  SINGLE_VISIT
  TRIAL
}

enum PlanBillingCycle {
  MONTH
  QUARTER
  HALF_YEAR
  YEAR
  ONE_OFF
}

enum PlanCreditType {
  CLASS
  APPOINTMENT
  FACILITY
  TIME
}

enum PlanCreditRefill {
  MONTHLY
  ONCE
}

enum PlanValidityUnit {
  DAY
  WEEK
  MONTH
}

enum PlanStartsOn {
  PURCHASE_DATE
  FIRST_BOOKING
}

enum PlanVisibility {
  PUBLIC
  HIDDEN
}

enum PlanStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

model Membership {
  id          String           @id
  name        String
  description String?
  createdAt   DateTime         @default(now())
  plans       MembershipPlan[]

  @@map("memberships")
}

model MembershipPlan {
  id                       String              @id
  name                     String
  kind                     PlanKind
  price                    Decimal             @db.Decimal(10, 2)
  billingCycle             PlanBillingCycle
  creditType               PlanCreditType
  creditsIncluded          Int
  creditRefill             PlanCreditRefill?
  validityValue            Int
  validityUnit             PlanValidityUnit
  startsOn                 PlanStartsOn
  oneTimePurchasePerClient Boolean             @default(false)
  visibility               PlanVisibility
  status                   PlanStatus          @default(ACTIVE)
  description              String?
  externalRef              String?             @unique
  version                  Int                 @default(1)
  membershipId             String?
  membership               Membership?         @relation(fields: [membershipId], references: [id], onDelete: Restrict)
  term                     String?
  recurring                Boolean             @default(false)
  periodMonths             Int?
  joiningFee               Decimal             @default(0) @db.Decimal(10, 2)
  eligibleClasses          ClassEligiblePlan[]
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt

  @@index([status])
  @@index([kind])
  @@index([creditType])
  @@index([status, creditType])
  @@index([membershipId])
  @@map("membership_plans")
}

enum ClassVisibility {
  PUBLIC
  PRIVATE
}

enum ClassStatus {
  ACTIVE
  DEACTIVATED
  ARCHIVED
}

enum ClassType {
  ONSITE
  ONLINE
}

enum SessionState {
  OPEN
  FULL
  CANCELLED
}

// Template side. Partial unique index on LOWER(name) WHERE status = 'ACTIVE' and the CHECK constraints
// live in the migration SQL (Prisma cannot express them). `version` is bumped by a DB trigger.
model Class {
  id               String              @id
  name             String
  description      String?
  durationMin      Int
  classType        ClassType           @default(ONSITE)
  baseCapacity     Int
  intensity        Int
  visibility       ClassVisibility
  classPassEnabled Boolean             @default(false)
  classpassSpots   Int                 @default(0)
  colour           String?
  photoUrl         String?
  status           ClassStatus         @default(ACTIVE)
  timezone         String              @default("Asia/Dubai")
  externalRef      String?             @unique
  version          Int                 @default(1)
  coaches          ClassCoach[]
  eligiblePlans    ClassEligiblePlan[]
  slots            ClassSlot[]
  sessions         ClassSession[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([status])
  @@map("classes")
}

model ClassCoach {
  classId String
  class   Class  @relation(fields: [classId], references: [id], onDelete: Cascade)
  coachId String
  coach   Coach  @relation(fields: [coachId], references: [id], onDelete: Cascade)

  @@id([classId, coachId])
  @@index([coachId])
  @@map("class_coaches")
}

model ClassEligiblePlan {
  classId String
  class   Class          @relation(fields: [classId], references: [id], onDelete: Cascade)
  planId  String
  plan    MembershipPlan @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@id([classId, planId])
  @@index([planId])
  @@map("class_eligible_plans")
}

// Weekly template. `dayOfWeek` is ISO (Monday = 1), `startTime` and `endTime` are facility wall-clock times,
// `capacity` null = use Class.baseCapacity.
model ClassSlot {
  id        String           @id
  classId   String
  class     Class            @relation(fields: [classId], references: [id], onDelete: Cascade)
  dayOfWeek Int
  startDate DateTime         @db.Date
  startTime DateTime         @db.Time(0)
  endTime   DateTime         @db.Time(0)
  capacity  Int?
  active    Boolean          @default(true)
  coaches   ClassSlotCoach[]
  sessions  ClassSession[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([classId])
  @@map("class_slots")
}

model ClassSlotCoach {
  slotId  String
  slot    ClassSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  coachId String
  coach   Coach     @relation(fields: [coachId], references: [id], onDelete: Cascade)

  @@id([slotId, coachId])
  @@index([coachId])
  @@map("class_slot_coaches")
}

// Instance side. slotId null = one-off. startAt/endAt/capacity are snapshots taken at creation.
model ClassSession {
  id               String              @id
  classId          String
  class            Class               @relation(fields: [classId], references: [id], onDelete: Restrict)
  slotId           String?
  slot             ClassSlot?          @relation(fields: [slotId], references: [id], onDelete: SetNull)
  startAt          DateTime
  endAt            DateTime
  capacity         Int
  state            SessionState        @default(OPEN)
  isPrivate        Boolean             @default(false)
  cancelReason     String?
  overriddenFields String[]            @default([])
  version          Int                 @default(1)
  source           String              @default("GENERATED")
  durationMin      Int?
  intensity        Int?
  classType        String?
  facility         String?
  description      String?
  image            String?
  overrideDetails  Json                @default("{}")
  coaches          ClassSessionCoach[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@unique([classId, startAt])
  @@index([startAt])
  @@index([slotId])
  @@index([startAt, classId])
  @@index([slotId, startAt])
  @@map("class_sessions")
}

model ClassSessionCoach {
  sessionId String
  session   ClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  coachId   String
  coach     Coach        @relation(fields: [coachId], references: [id], onDelete: Restrict)

  @@id([sessionId, coachId])
  @@index([coachId])
  @@index([coachId, sessionId])
  @@map("class_session_coaches")
}

enum CafeItemAvailability {
  AVAILABLE
  SOLD_OUT
}

enum CafeItemVisibility {
  PUBLIC
  STAFF_ONLY
}

model CafeCategory {
  id          String     @id
  name        String
  description String?
  items       CafeItem[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("cafe_categories")
}

model CafeItem {
  id            String               @id
  name          String
  categoryId    String
  category      CafeCategory         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  description   String?
  nutrition     Json?
  priceAed      Decimal              @db.Decimal(10, 2)
  imageUrl      String?
  availability  CafeItemAvailability @default(AVAILABLE)
  visibility    CafeItemVisibility   @default(PUBLIC)
  isTracked     Boolean              @default(true)
  stockQuantity Int?
  unitCost      Decimal?             @db.Decimal(10, 2)
  externalRef   String?              @unique
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([categoryId])
  @@index([visibility])
  @@index([availability])
  @@index([visibility, availability])
  @@map("cafe_items")
}

// SLAPP-79/82: cafe order queue. Orders are created by a later ticket; this schema is read by
// the order list, detail and summary endpoints.
enum CafeOrderStatus {
  PREPARING
  READY
  SERVED
}

// Payments are not tracked. A single value means "paid" cannot be stored at all.
enum CafeOrderPaymentStatus {
  NOT_TRACKED
}

model CafeOrder {
  id            String                 @id
  orderNumber   String                 @unique
  status        CafeOrderStatus        @default(PREPARING)
  createdById   String
  createdBy     User                   @relation(fields: [createdById], references: [id], onDelete: Restrict)
  customerName  String?
  totalAed      Decimal                @db.Decimal(10, 2)
  paymentStatus CafeOrderPaymentStatus @default(NOT_TRACKED)
  items         CafeOrderItem[]
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@index([createdAt, id])
  @@index([createdById, createdAt])
  @@index([status])
  @@map("cafe_orders")
}

// Line items are snapshots: no FK to cafe_items, so catalogue renames, price changes and deletes
// never alter history. A DB trigger rejects updates to the snapshot columns.
model CafeOrderItem {
  id           String    @id
  orderId      String
  order        CafeOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  itemName     String
  unitPriceAed Decimal   @db.Decimal(10, 2)
  quantity     Int

  @@index([orderId])
  @@index([itemName])
  @@map("cafe_order_items")
}

// SLAPP-104 (BE-SET-1): studio-wide booking rules. One row per rule in the business catalogue
// (src/constants/bookingRule.js). A deleted row means the rule is not applied. The CHECK
// constraints (value bounds per unit, unit and value set together) live in the migration SQL.
enum BookingRuleCategory {
  BOOKING_WINDOW
  CANCELLATIONS
  WAITLIST_GUESTS_CAPACITY
  BOOKING_LIMIT
  APPOINTMENTS
  FACILITIES
  MEMBERSHIPS_ACCOUNTS
  CLASSPASS
}

enum BookingRuleUnit {
  HOURS
  DAYS
  COUNT
  PERCENT
}

model BookingRule {
  id        String              @id
  ruleKey   String              @unique
  category  BookingRuleCategory
  name      String
  value     Int?
  unit      BookingRuleUnit?
  enabled   Boolean
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@index([category])
  @@map("booking_rules")
}
