generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  MEMBER
  COACH
  ADMIN
  OWNER
}

enum AccountStatus {
  PENDING
  ACTIVE
  DISABLED
}

enum Gender {
  MALE
  FEMALE
  NON_BINARY
  PREFER_NOT_TO_SAY
}

enum Relationship {
  PARENT
  SPOUSE
  SIBLING
  CHILD
  FRIEND
  GUARDIAN
  OTHER
}

enum AuditAction {
  LOGIN_SUCCESS
  LOGIN_FAILED
  STAFF_CREATED
  STAFF_CREATE_DENIED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_OTP_VERIFIED
  PASSWORD_RESET_OTP_FAILED
  PASSWORD_RESET_COMPLETED
  LOGOUT
  COACH_UPDATED
  COACH_STATUS_CHANGED
  PLAN_CREATED
  PLAN_UPDATED
  PLAN_STATUS_CHANGED
}

enum LoginFailureReason {
  INVALID_CREDENTIALS
  ACCOUNT_PENDING
  ACCOUNT_DISABLED
}

enum CoachType {
  SALARIED
  FREELANCE
}

enum CoachStatus {
  ACTIVE
  INACTIVE
}

model User {
  id                      String             @id
  fullName                String
  email                   String             @unique
  phone                   String
  whatsappNumber          String?
  gender                  Gender
  birthDay                Int?
  birthMonth              Int?
  profileImageUrl         String?
  passwordHash            String
  role                    Role               @default(MEMBER)
  status                  AccountStatus      @default(PENDING)
  mustChangePassword      Boolean            @default(false)
  waiverAcceptedAt        DateTime?
  registrationCompletedAt DateTime?
  lastLoginAt             DateTime?
  emergencyContact        EmergencyContact?
  coach                   Coach?
  refreshSessions         RefreshSession[]
  auditLogs               AuditLog[]
  passwordResetOtps       PasswordResetOtp[]
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
}

model EmergencyContact {
  id           String        @id
  userId       String        @unique
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String?
  phone        String
  relationship Relationship?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Coach {
  id        String              @id
  userId    String              @unique
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  coachType CoachType
  bio       String?
  status    CoachStatus         @default(ACTIVE)
  classes   ClassCoach[]
  slots     ClassSlotCoach[]
  sessions  ClassSessionCoach[]
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@index([status])
  @@index([coachType])
}

model RefreshSession {
  id        String    @id
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  ipAddress String?
  userAgent String?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model PasswordResetOtp {
  id             String    @id
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  otpHash        String
  expiresAt      DateTime
  attempts       Int       @default(0)
  verifiedAt     DateTime?
  usedAt         DateTime?
  invalidatedAt  DateTime?
  resetTokenHash String?   @unique
  ipAddress      String?
  createdAt      DateTime  @default(now())

  @@index([userId, createdAt])
}

model AuditLog {
  id        String      @id
  userId    String?
  user      User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    AuditAction
  reason    String?
  email     String?
  actorId   String?
  actorRole String?
  details   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime    @default(now())

  @@index([userId, createdAt])
}

enum PlanKind {
  SUBSCRIPTION
  CREDIT_PACK
  SINGLE_VISIT
  TRIAL
}

enum PlanBillingCycle {
  MONTH
  QUARTER
  HALF_YEAR
  YEAR
  ONE_OFF
}

enum PlanCreditType {
  CLASS
  APPOINTMENT
  FACILITY
  TIME
}

enum PlanCreditRefill {
  MONTHLY
  ONCE
}

enum PlanValidityUnit {
  DAY
  WEEK
  MONTH
}

enum PlanStartsOn {
  PURCHASE_DATE
  FIRST_BOOKING
}

enum PlanVisibility {
  PUBLIC
  HIDDEN
}

enum PlanStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

model MembershipPlan {
  id                       String              @id
  name                     String
  kind                     PlanKind
  price                    Decimal             @db.Decimal(10, 2)
  billingCycle             PlanBillingCycle
  creditType               PlanCreditType
  creditsIncluded          Int
  creditRefill             PlanCreditRefill?
  validityValue            Int
  validityUnit             PlanValidityUnit
  startsOn                 PlanStartsOn
  oneTimePurchasePerClient Boolean             @default(false)
  visibility               PlanVisibility
  status                   PlanStatus          @default(ACTIVE)
  description              String?
  externalRef              String?             @unique
  version                  Int                 @default(1)
  eligibleClasses          ClassEligiblePlan[]
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt

  @@index([status])
  @@index([kind])
  @@index([creditType])
  @@index([status, creditType])
  @@map("membership_plans")
}

enum ClassVisibility {
  PUBLIC
  PRIVATE
}

enum SessionState {
  OPEN
  FULL
  CANCELLED
}

// Template side. Partial unique index on LOWER(name) WHERE active and the CHECK constraints
// live in the migration SQL (Prisma cannot express them). `version` is bumped by a DB trigger.
model Class {
  id             String              @id
  name           String
  description    String?
  durationMin    Int
  baseCapacity   Int
  intensity      Int?
  visibility     ClassVisibility
  classpassSpots Int                 @default(0)
  colour         String?
  photoUrl       String?
  active         Boolean             @default(true)
  externalRef    String?             @unique
  version        Int                 @default(1)
  coaches        ClassCoach[]
  eligiblePlans  ClassEligiblePlan[]
  slots          ClassSlot[]
  sessions       ClassSession[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([active])
  @@map("classes")
}

model ClassCoach {
  classId String
  class   Class  @relation(fields: [classId], references: [id], onDelete: Cascade)
  coachId String
  coach   Coach  @relation(fields: [coachId], references: [id], onDelete: Cascade)

  @@id([classId, coachId])
  @@index([coachId])
  @@map("class_coaches")
}

model ClassEligiblePlan {
  classId String
  class   Class          @relation(fields: [classId], references: [id], onDelete: Cascade)
  planId  String
  plan    MembershipPlan @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@id([classId, planId])
  @@index([planId])
  @@map("class_eligible_plans")
}

// Weekly template. `dayOfWeek` is ISO (Monday = 1), `startTime` is Asia/Dubai wall-clock time,
// `capacity` null = use Class.baseCapacity. The end time is startTime + Class.durationMin.
model ClassSlot {
  id        String           @id
  classId   String
  class     Class            @relation(fields: [classId], references: [id], onDelete: Cascade)
  dayOfWeek Int
  startTime DateTime         @db.Time(0)
  capacity  Int?
  active    Boolean          @default(true)
  coaches   ClassSlotCoach[]
  sessions  ClassSession[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([classId, dayOfWeek, startTime])
  @@map("class_slots")
}

model ClassSlotCoach {
  slotId  String
  slot    ClassSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  coachId String
  coach   Coach     @relation(fields: [coachId], references: [id], onDelete: Cascade)

  @@id([slotId, coachId])
  @@index([coachId])
  @@map("class_slot_coaches")
}

// Instance side. slotId null = one-off. startAt/endAt/capacity are snapshots taken at creation.
model ClassSession {
  id           String              @id
  classId      String
  class        Class               @relation(fields: [classId], references: [id], onDelete: Restrict)
  slotId       String?
  slot         ClassSlot?          @relation(fields: [slotId], references: [id], onDelete: SetNull)
  startAt      DateTime
  endAt        DateTime
  capacity     Int
  state        SessionState        @default(OPEN)
  isPrivate    Boolean             @default(false)
  cancelReason String?
  version      Int                 @default(1)
  coaches      ClassSessionCoach[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@unique([classId, startAt])
  @@index([startAt])
  @@index([slotId])
  @@map("class_sessions")
}

model ClassSessionCoach {
  sessionId String
  session   ClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  coachId   String
  coach     Coach        @relation(fields: [coachId], references: [id], onDelete: Restrict)

  @@id([sessionId, coachId])
  @@index([coachId])
  @@map("class_session_coaches")
}
