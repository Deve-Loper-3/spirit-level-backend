generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  MEMBER
  COACH
  ADMIN
  OWNER
}

enum AccountStatus {
  PENDING
  ACTIVE
  DISABLED
}

enum Gender {
  MALE
  FEMALE
  NON_BINARY
  PREFER_NOT_TO_SAY
}

enum Relationship {
  PARENT
  SPOUSE
  SIBLING
  CHILD
  FRIEND
  GUARDIAN
  OTHER
}

enum AuditAction {
  LOGIN_SUCCESS
  LOGIN_FAILED
  STAFF_CREATED
  STAFF_CREATE_DENIED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_OTP_VERIFIED
  PASSWORD_RESET_OTP_FAILED
  PASSWORD_RESET_COMPLETED
  LOGOUT
  COACH_UPDATED
  COACH_STATUS_CHANGED
  PLAN_CREATED
  PLAN_UPDATED
  PLAN_STATUS_CHANGED
}

enum LoginFailureReason {
  INVALID_CREDENTIALS
  ACCOUNT_PENDING
  ACCOUNT_DISABLED
}

enum CoachType {
  SALARIED
  FREELANCE
}

enum CoachStatus {
  ACTIVE
  INACTIVE
}

model User {
  id                      String             @id
  fullName                String
  email                   String             @unique
  phone                   String
  whatsappNumber          String?
  gender                  Gender
  birthDay                Int?
  birthMonth              Int?
  profileImageUrl         String?
  passwordHash            String
  role                    Role               @default(MEMBER)
  status                  AccountStatus      @default(PENDING)
  mustChangePassword      Boolean            @default(false)
  waiverAcceptedAt        DateTime?
  registrationCompletedAt DateTime?
  lastLoginAt             DateTime?
  emergencyContact        EmergencyContact?
  coach                   Coach?
  refreshSessions         RefreshSession[]
  auditLogs               AuditLog[]
  passwordResetOtps       PasswordResetOtp[]
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
}

model EmergencyContact {
  id           String        @id
  userId       String        @unique
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String?
  phone        String
  relationship Relationship?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Coach {
  id        String      @id
  userId    String      @unique
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  coachType CoachType
  bio       String?
  status    CoachStatus @default(ACTIVE)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([status])
  @@index([coachType])
}

model RefreshSession {
  id        String    @id
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  ipAddress String?
  userAgent String?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model PasswordResetOtp {
  id             String    @id
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  otpHash        String
  expiresAt      DateTime
  attempts       Int       @default(0)
  verifiedAt     DateTime?
  usedAt         DateTime?
  invalidatedAt  DateTime?
  resetTokenHash String?   @unique
  ipAddress      String?
  createdAt      DateTime  @default(now())

  @@index([userId, createdAt])
}

model AuditLog {
  id        String      @id
  userId    String?
  user      User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    AuditAction
  reason    String?
  email     String?
  actorId   String?
  actorRole String?
  details   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime    @default(now())

  @@index([userId, createdAt])
}

enum PlanKind {
  SUBSCRIPTION
  CREDIT_PACK
  SINGLE_VISIT
  TRIAL
}

enum PlanBillingCycle {
  MONTH
  QUARTER
  HALF_YEAR
  YEAR
  ONE_OFF
}

enum PlanCreditType {
  CLASS
  APPOINTMENT
  FACILITY
  TIME
}

enum PlanCreditRefill {
  MONTHLY
  ONCE
}

enum PlanValidityUnit {
  DAY
  WEEK
  MONTH
}

enum PlanStartsOn {
  PURCHASE_DATE
  FIRST_BOOKING
}

enum PlanVisibility {
  PUBLIC
  HIDDEN
}

enum PlanStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

model MembershipPlan {
  id                       String            @id
  name                     String
  kind                     PlanKind
  price                    Decimal           @db.Decimal(10, 2)
  billingCycle             PlanBillingCycle
  creditType               PlanCreditType
  creditsIncluded          Int
  creditRefill             PlanCreditRefill?
  validityValue            Int
  validityUnit             PlanValidityUnit
  startsOn                 PlanStartsOn
  oneTimePurchasePerClient Boolean           @default(false)
  visibility               PlanVisibility
  status                   PlanStatus        @default(ACTIVE)
  description              String?
  externalRef              String?           @unique
  version                  Int               @default(1)
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt

  @@index([status])
  @@index([kind])
  @@index([creditType])
  @@index([status, creditType])
  @@map("membership_plans")
}
